{
  "name": "@e2e-dev/mobile",
  "version": "0.11.0",
  "description": "Mobile engine (iOS and Android) for e2e agentic end-to-end testing, built on agent-device, with an optional argent driver",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "mobile-testing",
    "ios",
    "android",
    "react-native",
    "expo",
    "simulator",
    "emulator",
    "agent-device",
    "argent"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Oskar Kwaśniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tester-army/e2e.git",
    "directory": "packages/mobile"
  },
  "bugs": {
    "url": "https://github.com/tester-army/e2e/issues"
  },
  "homepage": "https://github.com/tester-army/e2e/tree/main/packages/mobile#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "agent-device": "0.21.22",
    "pngjs": "7.0.0",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "@swmansion/argent": ">=0.28.0 <1",
    "ai": "^7.0.0",
    "e2e": ">=0.15.0 <1"
  },
  "peerDependenciesMeta": {
    "@swmansion/argent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swmansion/argent": "0.28.0",
    "@types/node": "26.6.2",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.107",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
