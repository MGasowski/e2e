{
  "name": "@e2e-dev/website-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Migration safety net: functional and visual suites for the e2e landing page and docs, run against production or website/",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node node_modules/e2e/dist/cli/bin.js run --exclude-tag visual",
    "test:visual": "node scripts/visual.mjs",
    "test:headed": "node node_modules/e2e/dist/cli/bin.js run --headed --exclude-tag visual",
    "sync:docs": "node scripts/sync-docs-pages.mjs"
  },
  "dependencies": {
    "@e2e-dev/web": "workspace:*",
    "e2e": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
